                "targetDashboardStateId": null,
                "openRightLayout": false,
                "setEntityId": true,
                "stateEntityParamName": null,
                "customFunction": "var $injector = widgetContext.$scope.$injector;\nvar attributeService = $injector.get(widgetContext.servicesMap.get('attributeService'));\n\n// 1. Extract the Entity ID and Type\nvar datasource = widgetContext.defaultSubscription.datasources[0];\nvar entityId = datasource ? datasource.entityId : null;\nvar entityType = datasource ? datasource.entityType : null;\n\nif (entityId && entityType) {\n    \n    // 2. Browser-native confirmation dialog\n    var message = \"Reset Calibration?\\n\\nThis will clear all current SPC limits and restart the calibration window.\";\n    \n    if (confirm(message)) {\n        // 3. User clicked \"OK\", proceed with the reset\n        var attributesToReset = [\n            { key: \"start_ts\", value: 0 },\n            { key: \"ss_ucl\", value: null },\n            { key: \"ss_lcl\", value: null },\n            { key: \"ss_mean\", value: null },\n            { key: \"total_rms\", value: \"[]\" }\n        ];\n\n        attributeService.saveEntityAttributes({ id: entityId, entityType: entityType }, \"SERVER_SCOPE\", attributesToReset).subscribe(\n            function() {\n                widgetContext.showSuccessToast(\"SPC Reset Successful\");\n                widgetContext.updateAliases();\n            },\n            function(err) {\n                widgetContext.showErrorToast(\"Reset Failed: \" + err.statusText);\n            }\n        );\n    }\n    // If user clicks \"Cancel\", the script simply ends here.\n\n} else {\n    widgetContext.showErrorToast(\"Error: Device mapping failed.\");\n}",
                "openInSeparateDialog": false,
                "openInPopover": false
              }
            ]
          }
